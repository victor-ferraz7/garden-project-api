PORT=3000
MONGO_URI=mongodb://localhost:27017/growapp

# Mínimo 16 caracteres cada
JWT_ACCESS_SECRET=change-me-access-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-min-16-chars

# Emissão/audiência dos JWT (padrões: gp-api / gp-api-clients)
# JWT_ISSUER=gp-api
# JWT_AUDIENCE=gp-api-clients

# Opcional (padrões: 15m access, 7d refresh)
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=7d

# CORS: em produção é obrigatório; origens separadas por vírgula (ex.: http://localhost:5173)
# CORS_ORIGIN=http://localhost:3000

# Atrás de proxy reverso (IP real em req.ip / rate limit)
# TRUST_PROXY=1

# Seed: exige confirmação explícita (apaga coleções do app). Senha ≥12 caracteres ou senha aleatória gerada.
# SEED_CONFIRM=1
# SEED_USER_EMAIL=seed@growapp.local
# SEED_USER_PASSWORD=umaSenhaForteCom12+
# Produção (opcional, bloqueia seed sem isso):
# SEED_ALLOW_IN_PRODUCTION=1
