PORT=3000
MONGO_URI=mongodb://localhost:27017/growapp

# Mínimo 16 caracteres cada
JWT_ACCESS_SECRET=change-me-access-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-min-16-chars

# Opcional (padrões: 15m access, 7d refresh)
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=7d

# Seed (opcional)
# SEED_USER_EMAIL=seed@growapp.local
# SEED_USER_PASSWORD=seedseed

# CORS: origens separadas por vírgula (ex.: http://localhost:5173)
# CORS_ORIGIN=http://localhost:3000
